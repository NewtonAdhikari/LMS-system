# Template environment variables for a ProFreeHost deployment
# Copy this file to .env and edit the placeholders before running.

APP_ENV=prod
APP_DEBUG=0
APP_SECRET=replace_this_with_a_random_32+_character_string
APP_INSTALLED=0

# ProFreeHost provides MySQL credentials; typically the host is "localhost".
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=your_db_name_here
DATABASE_USER=your_db_user_here
DATABASE_PASSWORD=your_db_password_here

# other environment variables may be left commented or set according to .env.dist
# you can also enable production caching, mail settings, etc.
